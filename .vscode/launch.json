{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API (watch + attach)",
      "type": "coreclr",
      "request": "attach",
      "processName": "App.API",
      "preLaunchTask": "api: watch"
    },
    {
      "name": "Attach to API (.NET)",
      "type": "coreclr",
      "request": "attach",
      "processName": "App.API"
    },
    {
      "name": "Launch API (.NET Core)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "api: build",
      "program": "${workspaceFolder}/API/bin/Debug/net10.0/App.API.dll",
      "args": [],
      "cwd": "${workspaceFolder}/API",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    {
      "name": "Launch Client (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:4200",
      "webRoot": "${workspaceFolder}/Client",
      "sourceMaps": true,
      "smartStep": true,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "sourceMapPathOverrides": {
        "webpack:///*": "${webRoot}/*",
        "/src/*": "${webRoot}/src/*",
        "src/*": "${webRoot}/src/*"
      },
      "preLaunchTask": "client: start"
    },
    {
      "name": "Launch Client (Edge)",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:4200",
      "webRoot": "${workspaceFolder}/Client",
      "sourceMaps": true,
      "smartStep": true,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "sourceMapPathOverrides": {
        "webpack:///*": "${webRoot}/*",
        "/src/*": "${webRoot}/src/*",
        "src/*": "${webRoot}/src/*"
      },
      "preLaunchTask": "client: start"
    },
    {
      "name": "Launch Client (Chrome, dev server already running)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:4200",
      "webRoot": "${workspaceFolder}/Client",
      "sourceMaps": true,
      "smartStep": true,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "sourceMapPathOverrides": {
        "webpack:///*": "${webRoot}/*",
        "/src/*": "${webRoot}/src/*",
        "src/*": "${webRoot}/src/*"
      }
    },
    {
      "name": "Attach to Client (Chrome)",
      "type": "chrome",
      "request": "attach",
      "port": 9222,
      "url": "http://localhost:4200",
      "webRoot": "${workspaceFolder}/Client",
      "sourceMaps": true,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    }
  ],
  "compounds": [
    {
      "name": "Full Stack (watch)",
      "configurations": ["API (watch + attach)", "Launch Client (Chrome)"]
    },
    {
      "name": "Full Stack (API + Client)",
      "configurations": ["Launch API (.NET Core)", "Launch Client (Chrome)"]
    }
  ]
}
